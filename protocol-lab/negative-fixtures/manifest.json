{
  "format": "ko1298-negative-fixtures-v1",
  "fixtures": [
    {
      "file": "truncated_frame.bin",
      "expect": "FRAME_REJECT"
    },
    {
      "file": "oversized_declared_length.bin",
      "expect": "FRAME_REJECT"
    },
    {
      "file": "wrong_string_length.bin",
      "expect": "SEMANTIC_REJECT_OR_UNKNOWN"
    },
    {
      "file": "invalid_magic_subopcode.bin",
      "expect": "UNKNOWN_VARIANT"
    },
    {
      "file": "impossible_attack_enum.bin",
      "expect": "ENUM_REJECT"
    },
    {
      "file": "malformed_header.bin",
      "expect": "FRAME_REJECT"
    },
    {
      "file": "unknown_opcode.bin",
      "expect": "UNKNOWN_OPCODE"
    }
  ],
  "non_binary_negative_tests": [
    "integer width overflow is rejected by serializer before bytes exist"
  ]
}
