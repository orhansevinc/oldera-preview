{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oldkoweb.invalid/schemas/catalog-entry.schema.json",
  "title": "OldKOWeb 1298 catalog entry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "category",
    "patch",
    "source",
    "confidence",
    "notes"
  ],
  "properties": {
    "id": {
      "oneOf": [
        {"type": "integer"},
        {"type": "string", "minLength": 1}
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "category": {
      "type": "string",
      "enum": ["ZONE", "ITEM", "NPC", "MONSTER", "SKILL", "CLASS", "RACE", "NATION", "QUEST", "EVENT", "CLIENT_RESOURCE", "NPC_TYPE"]
    },
    "patch": {"type": "string", "enum": ["1298", "UNKNOWN", "MODERN", "OUT_OF_SCOPE"]},
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
    "notes": {"type": "string"}
  }
}
