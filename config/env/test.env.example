# Deterministic CI/test defaults. No real secrets.
OLDKO_ENV=test
OLDKO_SERVICE_NAME=config-test
OLDKO_SERVICE_HOST=127.0.0.1

OLDKO_DB_ENABLED=false
OLDKO_GATEWAY_ENABLED=false
OLDKO_ADMIN_API_ENABLED=false

OLDKO_LOG_LEVEL=error
OLDKO_LOG_JSON=true
OLDKO_METRICS_ENABLED=false
OLDKO_HEALTH_PATH=/health

OLDKO_TRUSTED_ORIGINS=http://127.0.0.1:5500
OLDKO_CORS_CREDENTIALS=false

OLDKO_STARTUP_TIMEOUT_MS=5000
OLDKO_REQUEST_TIMEOUT_MS=2000
OLDKO_DB_TIMEOUT_MS=2000
OLDKO_GATEWAY_TIMEOUT_MS=2000

OLDKO_FF_EXAMPLE=true
