# Template only. Values below are placeholders, not production credentials.
OLDKO_ENV=production
OLDKO_SERVICE_NAME=replace-service-name
OLDKO_SERVICE_HOST=0.0.0.0
# OLDKO_SERVICE_PORT=REPLACE_WITH_VALID_PORT

OLDKO_DB_ENABLED=true
OLDKO_DB_DRIVER=postgres
OLDKO_DB_HOST=db.internal.example
OLDKO_DB_PORT=5432
OLDKO_DB_NAME=replace_db_name
OLDKO_DB_USER=replace_db_user
OLDKO_DB_PASSWORD_REF=secret://deployment/oldko-db-password

OLDKO_GATEWAY_ENABLED=true
OLDKO_GATEWAY_AUTH_TARGET_URL=https://auth.internal.example
OLDKO_GATEWAY_GAME_TARGET_URL=https://game.internal.example

# Set these only for services that open the raw KO endpoints.
# OLDKO_AUTH_HOST=0.0.0.0
# OLDKO_AUTH_PORT=REPLACE_WITH_VALID_PORT
# OLDKO_GAME_HOST=0.0.0.0
# OLDKO_GAME_PORT=REPLACE_WITH_VALID_PORT

OLDKO_ADMIN_API_ENABLED=false
# OLDKO_ADMIN_API_BASE_URL=https://admin-api.internal.example
# OLDKO_ADMIN_SESSION_SECRET_REF=secret://deployment/admin-session-secret
# OLDKO_GAME_COMMAND_TOKEN_REF=secret://deployment/game-command-token

OLDKO_LOG_LEVEL=info
OLDKO_LOG_JSON=true
OLDKO_METRICS_ENABLED=true
OLDKO_METRICS_HOST=0.0.0.0
OLDKO_METRICS_PORT=9090
OLDKO_HEALTH_PATH=/health

OLDKO_TRUSTED_ORIGINS=https://admin.oldkoweb.com,https://play.oldkoweb.com
OLDKO_CORS_CREDENTIALS=true

OLDKO_STARTUP_TIMEOUT_MS=30000
OLDKO_REQUEST_TIMEOUT_MS=15000
OLDKO_DB_TIMEOUT_MS=10000
OLDKO_GATEWAY_TIMEOUT_MS=10000
