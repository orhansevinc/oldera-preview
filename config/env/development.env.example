# Safe example only. No real secrets.
OLDKO_ENV=development
OLDKO_SERVICE_NAME=example-service
OLDKO_SERVICE_HOST=127.0.0.1
OLDKO_SERVICE_PORT=8787

OLDKO_DB_ENABLED=false
# Enable only when a local database is required:
# OLDKO_DB_DRIVER=mssql
# OLDKO_DB_HOST=127.0.0.1
# OLDKO_DB_PORT=1433
# OLDKO_DB_NAME=KN_online
# OLDKO_DB_USER=dev_user
# OLDKO_DB_PASSWORD_REF=env://OLDKO_LOCAL_DB_PASSWORD

OLDKO_GATEWAY_ENABLED=false
# OLDKO_GATEWAY_AUTH_TARGET_URL=http://127.0.0.1:9101
# OLDKO_GATEWAY_GAME_TARGET_URL=http://127.0.0.1:9102

# Protocol-owning workstreams supply actual deployment ports.
# OLDKO_AUTH_HOST=127.0.0.1
# OLDKO_AUTH_PORT=15001
# OLDKO_GAME_HOST=127.0.0.1
# OLDKO_GAME_PORT=15002

OLDKO_ADMIN_API_ENABLED=false
# OLDKO_ADMIN_API_BASE_URL=http://127.0.0.1:8787
# OLDKO_ADMIN_SESSION_SECRET_REF=env://OLDKO_LOCAL_ADMIN_SESSION_SECRET
# OLDKO_GAME_COMMAND_TOKEN_REF=env://OLDKO_LOCAL_GAME_COMMAND_TOKEN

OLDKO_LOG_LEVEL=debug
OLDKO_LOG_JSON=false
OLDKO_METRICS_ENABLED=false
OLDKO_HEALTH_PATH=/health

OLDKO_TRUSTED_ORIGINS=http://localhost:5500
OLDKO_CORS_CREDENTIALS=true

OLDKO_STARTUP_TIMEOUT_MS=30000
OLDKO_REQUEST_TIMEOUT_MS=15000
OLDKO_DB_TIMEOUT_MS=10000
OLDKO_GATEWAY_TIMEOUT_MS=10000

OLDKO_FF_EXAMPLE=false
