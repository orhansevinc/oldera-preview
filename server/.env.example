PORT=8787
NODE_ENV=development

# Browser origin allowed to call the API. In production use https://admin.oldkoweb.com
ADMIN_ORIGIN=http://localhost:5500

# ROOT OWNER login. Never commit real values.
ROOT_OWNER_USER=ORHAN
ROOT_OWNER_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-secret

# Knight Online SQL Server
KO_DB_ENABLED=false
KO_DB_HOST=127.0.0.1
KO_DB_PORT=1433
KO_DB_NAME=KN_online
# Open-KO style installs may keep CURRENTUSER in a separate account DB on the same SQL Server.
# Leave blank to use KO_DB_NAME for everything.
KO_ACCOUNT_DB_NAME=
KO_DB_USER=sa
KO_DB_PASSWORD=change-me
KO_DB_ENCRYPT=false
KO_DB_TRUST_CERT=true

# Standard 1298 table names; override only if your database differs.
KO_USERDATA_TABLE=USERDATA
KO_CURRENTUSER_TABLE=CURRENTUSER
KO_WAREHOUSE_TABLE=WAREHOUSE
KO_ACCOUNT_CHAR_TABLE=ACCOUNT_CHAR

# Optional command bridge exposed by the real game server.
# POST {GAME_COMMAND_BRIDGE_URL}/commands with the same payload used by /api/admin/commands.
GAME_COMMAND_BRIDGE_URL=
GAME_COMMAND_BRIDGE_TOKEN=
