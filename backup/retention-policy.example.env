# Example policy only. Deletion must be performed by the storage/backup orchestrator,
# never by the backup creation script itself.
FULL_BACKUP_SCHEDULE_UTC="15 02 * * *"
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
IMMUTABLE_RETENTION_DAYS=7
# Production target after WAL/PITR is enabled and tested.
TARGET_RPO_MINUTES=15
TARGET_RTO_MINUTES=60
