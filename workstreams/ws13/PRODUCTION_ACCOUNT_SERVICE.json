  },
  "routes": [
    "POST /api/account/v1/accounts/register",
    "POST /api/account/v1/accounts/verification/request",
    "POST /api/account/v1/accounts/verification/confirm",
    "POST /api/account/v1/session/login",
    "GET /api/account/v1/session/current",
    "POST /api/account/v1/session/logout",
    "POST /api/account/v1/password/change",
    "POST /api/account/v1/password-reset/request",
    "POST /api/account/v1/password-reset/confirm",
    "POST /api/account/v1/accounts/access-check"
  ],
  "frontend_compatibility_routes": [
    "POST /api/account/v1/accounts/password/change",
    "POST /api/account/v1/accounts/password-reset/request",
    "POST /api/account/v1/accounts/password-reset/confirm"
  ],
  "credential_contract": "services/account-api/contracts/credential-policy.v1.json",
  "credential_policy": {
    "username": "exact 4-20 ASCII bytes; first letter; remaining letters/digits/underscore; lowercase canonical lookup; no input trim",
    "password_write": "exact 10-12 printable ASCII bytes U+0021-U+007E; at least 3 character classes; no spaces/trim/Unicode normalization/truncation",
    "applies_to": ["register", "password change newPassword", "password reset newPassword"],
    "legacy_transition": "existing incompatible password may web-login exactly with credentialUpgradeRequired=true; game access-check rejects CREDENTIAL_UPGRADE_REQUIRED until change/reset",
    "ko1298_packet_limits_changed": false
  },
  "health": {
    "liveness": "GET /healthz",
    "readiness": "GET /readyz",
    "readiness_dependencies": ["WS07 PostgreSQL account repository", "PostgreSQL shared rate-limit table"]
  },
  "session_cookie": {
    "name": "oldko_session",
    "secure": true,
    "http_only": true,
    "same_site": "Strict",
    "path": "/"
  },
  "production_repository": {
    "required": "exact pinned WS07 PgWs13AccountRepository",
    "in_memory_allowed": false,
    "account_table": "oldko.accounts",
    "session_table": "oldko.account_sessions",
    "action_token_table": "oldko.account_action_tokens"
  },
  "password_hash": {
    "format": "scrypt$N$r$p$base64(salt)$base64(hash64)",
    "params": {"N": 32768, "r": 8, "p": 1, "hash_bytes": 64},
    "ws07_game_verifier": "services/oldko-data/src/index.js#verifyPassword",
    "legacy_ws13_read_compatibility": true
  },
  "rate_limit": {
    "backend": "PostgreSQL",
    "table": "oldko.account_rate_limits",
    "migration": "services/account-api/sql/0001_postgres_rate_limit.sql",
    "process_local_allowed_in_production": false,
    "stored_key_material": "SHA-256 bucket hashes only",
    "old_process_local_blocker": "closed"
  },
  "delivery": {
    "contract": "services/account-api/contracts/mail-delivery-webhook.v1.json",
    "type": "signed HTTPS webhook",
    "provider_acceptance_required": true,
    "http_2xx_alone_is_success": false,
    "mailbox_delivery_proven_by_provider_ack": false,
    "secret_source": "environment/deployment secret store only",
    "token_transport": "signed JSON request body only",
    "dev_token_public_output": false,
    "fake_mail": false
  },
  "required_env": [
    "NODE_ENV=production",
    "DATABASE_URL",
    "OLDKO_ACCOUNT_REPOSITORY_MODULE",
    "OLDKO_ACCOUNT_DELIVERY_WEBHOOK_URL",
    "OLDKO_ACCOUNT_DELIVERY_WEBHOOK_SECRET",
    "OLDKO_ACCOUNT_MAIL_FROM=<sender@oldkoweb.com>",
    "OLDKO_ACCOUNT_ALLOWED_ORIGINS=https://oldkoweb.com",
    "OLDKO_TRUST_PROXY=0|1"
  ],
  "optional_env": ["PORT", "OLDKO_DB_SSL=require"],
  "required_prestart": [
    "Apply pinned WS07 migrations through database/migrations/0003_public_account_api.sql",
    "Apply services/account-api/sql/0001_postgres_rate_limit.sql",
    "Provide the exact pinned WS07 account repository module file",
    "Provision signed HTTPS mail receiver URL/secret",
    "Verify oldkoweb.com sender domain with the real provider and configure OLDKO_ACCOUNT_MAIL_FROM"
  ],
  "frontend_contract": {
    "handoff_commit": "8370de2ebfdfd319cf8a719da79cbdef9853fd2f",
    "asset": "account-v15.js",
    "account_api_base": "/api/account",
    "route_contract_changed": false,
