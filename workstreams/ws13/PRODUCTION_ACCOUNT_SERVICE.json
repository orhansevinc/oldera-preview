  },
  "security": {
    "trusted_origin_required_for_browser_mutations": true,
    "internal_game_access_check_origin_exempt": true,
    "current_session_database_authoritative": true,
    "password_rotation_invalidates_old_web_sessions_via_passwordVersion": true,
    "tokens_single_use_and_ttl_backed": true,
    "new_password_validated_before_reset_token_consumption": true,
    "tokens_logged": false,
    "tokens_in_urls": false,
    "secrets_in_repository": false
  },
  "validation_scope": {
    "postgres": ["register", "verify", "login", "current", "logout", "change", "reset", "used token", "expired token", "disallowed Origin", "rate-limit persistence", "frontend aliases", "12-byte game access-check", "13-byte rejection"],
