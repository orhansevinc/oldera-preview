{
  "brand": {
    "product": "OldKOWeb",
    "game": "OldKO",
    "patch": "1298"
  },
  "cacheVersion": "manifest-v1",
  "publication": {
    "latestUrl": "/latest.json",
    "requirePublicationMarker": true,
    "verifyRequiredFiles": true,
    "strictContentType": true,
    "timeoutMs": 120000
  },
  "gateway": {
    "endpoints": [
      { "name": "auth", "url": "/auth" },
      { "name": "game", "url": "/game" }
    ],
    "required": true,
    "timeoutMs": 4000
  },
  "runtime": {
    "readySelector": "#status",
    "readyText": "WASM hazır",
    "errorText": "[ERR]",
    "timeoutMs": 90000
  },
  "mobile": {
    "policy": "warn",
    "message": "OldKO 1298 masaüstü klavye/fare akışı için tasarlandı. Mobilde launcher açılabilir ancak oyun kontrolü desteklenmeyebilir."
  }
}
