        "item": { "$catalog": "item.tradeable.any" },
        "startingCoins": 100000,
        "flow": ["BUY", "SELL"]
      }
    },
    {
      "id": "ws49.economy.trade-rollback",
      "seed": 49502,
      "description": "Two-party trade fixture with an explicit rollback checkpoint and invariant.",
      "payload": {
        "tradeId": { "$fixtureId": ["trade", "rollback"] },
        "leftCharacterId": { "$fixtureId": ["character", "trade-left"] },
        "rightCharacterId": { "$fixtureId": ["character", "trade-right"] },
        "item": { "$catalog": "item.tradeable.any" },
        "checkpoint": "AFTER_LEFT_COMMIT_BEFORE_RIGHT_COMMIT",
        "expected": "ROLLBACK_TO_PRE_TRADE_STATE"
      }
    },
    {
      "id": "ws49.economy.inn-transfer",
