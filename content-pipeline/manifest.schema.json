{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oldkoweb.com/contracts/client-content-manifest-v1.schema.json",
  "title": "OldKOWeb Client Content Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "buildId",
    "createdAt",
    "source",
    "immutableBasePath",
    "files",
    "manifestChecksum"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "buildId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "immutableBasePath": {
      "type": "string",
      "pattern": "^/.+/$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "required", "role", "contentType"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "required": { "type": "boolean" },
          "role": { "type": "string", "minLength": 1 },
          "contentType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentVersion", "manifestPath", "manifestFileSha256"],
      "properties": {
        "contentVersion": { "type": "string", "minLength": 1 },
        "manifestPath": { "type": "string", "minLength": 1 },
        "manifestFileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "manifestChecksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "oldkoweb-json-v1" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "signedField", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 },
        "signedField": { "const": "manifestChecksum.value" },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
