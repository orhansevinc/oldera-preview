# Local defaults. Copy to .env on the deployment host; do not commit real secrets.
NGINX_IMAGE=nginx:stable-alpine
POSTGRES_IMAGE=postgres:17-alpine

# Workstream-built images. Replace tags with immutable release SHAs for production.
ADMIN_API_IMAGE=ghcr.io/orhansevinc/oldkoweb-admin-api:ws08
KO_SESSION_IMAGE=ghcr.io/orhansevinc/oldkoweb-ko1298-session:ws03
GATEWAY_IMAGE=ghcr.io/orhansevinc/oldkoweb-ko-gateway:ws02

# Local mode until oldkoweb.com is actually purchased/configured.
NGINX_TEMPLATE=local.conf.template
OFFICIAL_HOST=oldkoweb.local
PLAY_HOST=play.oldkoweb.local
ADMIN_HOST=admin.oldkoweb.local
API_HOST=api.oldkoweb.local
GATEWAY_HOST=gateway.oldkoweb.local
HTTP_BIND=8080
HTTPS_BIND=8443

ADMIN_API_PORT=8080
GATEWAY_PORT=8080
KO_SESSION_PORT=15001
POSTGRES_DB=oldkoweb
POSTGRES_USER=oldkoweb
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password.txt
TLS_CERT_DIR=./deploy/tls
