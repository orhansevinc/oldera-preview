# WS09 production contract example.
# Copy to a host-local .env.production and replace every REQUIRED_* image value
# with an immutable <registry>/<image>@sha256:<64-hex> identity before deploy.
# Do not commit the host-local file or any secret.

NGINX_IMAGE=REQUIRED_NGINX_IMAGE_DIGEST
POSTGRES_IMAGE=REQUIRED_POSTGRES_IMAGE_DIGEST
ADMIN_API_IMAGE=REQUIRED_ADMIN_API_IMAGE_DIGEST
GATEWAY_IMAGE=REQUIRED_WS02_GATEWAY_IMAGE_DIGEST
KO_SESSION_WORLD_IMAGE=REQUIRED_WS03_WS14_SESSION_WORLD_IMAGE_DIGEST

OFFICIAL_HOST=oldkoweb.com
PLAY_HOST=play.oldkoweb.com
ADMIN_HOST=admin.oldkoweb.com
PLAY_PUBLIC_ORIGIN=https://play.oldkoweb.com
PLAY_ALLOWED_HOST=play.oldkoweb.com
KO_GAME_ADVERTISE_HOST=play.oldkoweb.com

HTTP_BIND=80
HTTPS_BIND=443
ADMIN_API_PORT=8080
GATEWAY_INTERNAL_PORT=8080
AUTH_TCP_PORT=15100
GAME_TCP_PORT=15001

POSTGRES_DB=oldkoweb
POSTGRES_USER=oldkoweb
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password.txt
TLS_CERT_DIR=./deploy/tls

# Exact passing client/rehearsal identity. Non-secret release metadata.
WS10_RUN_ID=38505039290
WS10_HEAD_SHA=f0cadfb50b5d1a36d2bfe4e5bf0a68f7c3061f41
WS10_PASS_ARTIFACT=ws10-moradon-e2e-26
WS10_CLIENT_ARTIFACT=ws10-moradon-passing-client-26
WS10_CLIENT_ARTIFACT_ID=11867980473
WS10_CLIENT_ARTIFACT_DIGEST=sha256:ff9fb679ad1b3caa184ad098cff81cfb5469b0698d5e5f3b76ef4fab2ea775b3
WS50_HANDOFF_REF=9e0fc1822351965755fc490c2d2abf34d40f430d
CONTENT_VERSION=1298-ws10-38505039290
BUILD_ID=ws10-38505039290-f0cadfb50b5d

# Conservative starting limits; tune from WS29 metrics rather than guessing upward.
NGINX_MEMORY_LIMIT=256m
NGINX_CPU_LIMIT=1.0
ADMIN_API_MEMORY_LIMIT=512m
ADMIN_API_CPU_LIMIT=1.0
SESSION_WORLD_MEMORY_LIMIT=1024m
SESSION_WORLD_CPU_LIMIT=2.0
GATEWAY_MEMORY_LIMIT=256m
GATEWAY_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1024m
POSTGRES_CPU_LIMIT=2.0
GATEWAY_LOG_LEVEL=info
