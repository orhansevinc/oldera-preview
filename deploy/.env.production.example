# WS09 production contract example for the permanent-domain release.
# Copy to a host-local .env.production and replace every REQUIRED_* value.
# Image values must be immutable <registry>/<image>@sha256:<64-hex> identities.
# Credentials and delivery secrets belong only in the host/provider secret store;
# never commit the populated production file.

NGINX_IMAGE=REQUIRED_NGINX_IMAGE_DIGEST
POSTGRES_IMAGE=REQUIRED_POSTGRES_IMAGE_DIGEST
ACCOUNT_API_IMAGE=REQUIRED_WS13_WS07_ACCOUNT_API_IMAGE_DIGEST
ADMIN_API_IMAGE=REQUIRED_ADMIN_API_IMAGE_DIGEST
GATEWAY_IMAGE=REQUIRED_WS02_GATEWAY_IMAGE_DIGEST
KO_SESSION_WORLD_IMAGE=REQUIRED_WS03_WS14_SESSION_WORLD_IMAGE_DIGEST

OFFICIAL_HOST=oldkoweb.com
PLAY_HOST=play.oldkoweb.com
ADMIN_HOST=admin.oldkoweb.com
PLAY_PUBLIC_ORIGIN=https://play.oldkoweb.com
PLAY_ALLOWED_HOST=play.oldkoweb.com
KO_GAME_ADVERTISE_HOST=play.oldkoweb.com

HTTP_BIND=80
HTTPS_BIND=443
ACCOUNT_API_PORT=8081
ADMIN_API_PORT=8080
GATEWAY_INTERNAL_PORT=8080
AUTH_TCP_PORT=15100
GAME_TCP_PORT=15001

POSTGRES_DB=oldkoweb
POSTGRES_USER=oldkoweb
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password.txt
TLS_CERT_DIR=./deploy/tls

# WS13 production fail-closed inputs. Populate only in secure host/provider config.
ACCOUNT_DATABASE_URL=REQUIRED_SECURE_ACCOUNT_DATABASE_URL
OLDKO_DB_SSL=disable
OLDKO_ACCOUNT_REPOSITORY_MODULE=/opt/oldkoweb/ws07/services/oldko-data/src/adapters/ws13-account-api.js
OLDKO_ACCOUNT_DELIVERY_WEBHOOK_URL=REQUIRED_SECURE_HTTPS_DELIVERY_WEBHOOK_URL
OLDKO_ACCOUNT_DELIVERY_WEBHOOK_SECRET=REQUIRED_SECURE_DELIVERY_WEBHOOK_SECRET

# Exact account/site authorities currently available to the WS09 publisher.
OFFICIAL_SITE_HANDOFF_COMMIT=8370de2ebfdfd319cf8a719da79cbdef9853fd2f
OFFICIAL_SITE_SOURCE_COMMIT=5f9a4f0ccd3d7d06e8b407bfca35266f1b2d3516
WS13_ACCOUNT_HEAD=1ef67bd7c0c98a588bce4db6c0f1305b820af008
WS13_ACCOUNT_RUN_ID=38650301600
WS07_ACCOUNT_COMMIT=1ae85c96319cbab11648a91ed28300e17d4c607f
WS08_ADMIN_HEAD=239cdacf0fb6bacde5017fb3b787451595a3be0d

# Exact immutable C5 + real-browser visibility release identity. This remains the
# only gameplay release WS09 may publish until WS50 selects and WS10 accepts a
# persistence-capable child candidate.
FINAL_PROVIDER_SET=WS50-C5@sha256:7ac3b8a4c06b67e52b8d18518ef8c82209a60c6101c33609a4c16e64d84f119e
WS50_MANIFEST_COMMIT=0d5001095fa3b43693b4fa0cda615f84e2cb7df5
WS50_HANDOFF_REF=7497087d4cf67e4e05a3a090f6edad3d206078cb
WS49_RUN_ID=38600254823
WS10_RUN_ID=38604174659
WS10_HEAD_SHA=163f2ebf81e750bf746fdaa277695329a0682e22
WS10_PASS_ARTIFACT=ws10-c5-visibility-e2e-4
WS10_CLIENT_ARTIFACT=ws10-c5-visibility-passing-client-4
WS10_CLIENT_ARTIFACT_ID=11915666463
WS10_CLIENT_ARTIFACT_DIGEST=sha256:f749750fc5bb0249a67b712bd4e1a03847773d8845fd209508b8c95f6c447a83
CONTENT_VERSION=1298-ws10-38604174659
BUILD_ID=ws10-38604174659-163f2ebf81e7

# Conservative starting limits; tune from WS29 metrics rather than guessing upward.
NGINX_MEMORY_LIMIT=256m
NGINX_CPU_LIMIT=1.0
ACCOUNT_API_MEMORY_LIMIT=512m
ACCOUNT_API_CPU_LIMIT=1.0
ADMIN_API_MEMORY_LIMIT=512m
ADMIN_API_CPU_LIMIT=1.0
SESSION_WORLD_MEMORY_LIMIT=1024m
SESSION_WORLD_CPU_LIMIT=2.0
GATEWAY_MEMORY_LIMIT=256m
GATEWAY_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1024m
POSTGRES_CPU_LIMIT=2.0
GATEWAY_LOG_LEVEL=info
