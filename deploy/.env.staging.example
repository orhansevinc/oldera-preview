# WS09 public-test/staging example. Copy to deploy/.env.staging on the host.
# This file contains no secrets and assumes no purchased production domain.

NGINX_IMAGE=nginx:stable-alpine

# Supply images built from the integrated provider refs after the Moradon gate is green.
# Pin immutable SHA/digest tags for an actual public test publish.
GATEWAY_IMAGE=ghcr.io/orhansevinc/oldkoweb-ko-gateway:ws02
KO_SESSION_WORLD_IMAGE=ghcr.io/orhansevinc/oldkoweb-ko1298-session-world:staging

# Local smoke defaults. For a public host, replace these three values together.
STAGING_HOST=localhost
STAGING_PUBLIC_ORIGIN=http://localhost:8080
STAGING_ALLOWED_HOST=localhost:8080
STAGING_HTTP_BIND=8080

# Browser-accessible gateway contract after external TLS termination:
#   wss://<STAGING_HOST>/auth
#   wss://<STAGING_HOST>/game
# Local HTTP smoke uses ws://localhost:8080/auth and /game.
GATEWAY_INTERNAL_PORT=8080
GATEWAY_LOG_LEVEL=info

# WS03 provider ports; both remain private inside the compose network.
AUTH_TCP_PORT=15100
GAME_TCP_PORT=15001

# Server-list host identity passed by WS03. Set this to the host identity expected by
# the integrated browser transport for the staging publish; do not point browsers at
# the private session-world container name.
KO_GAME_ADVERTISE_HOST=localhost
